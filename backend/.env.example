# ────────────────────────────────────────────────────────
#  Environment Configuration
# ────────────────────────────────────────────────────────
#
#  🐳 Docker:  cp .env.docker backend/.env
#              then: docker-compose up -d
#
#  💻 Local:   cp backend/.env.example backend/.env
#              then: php artisan key:generate
#              then: touch database/database.sqlite
#              then: php artisan migrate
#              then: php artisan serve  (or: composer run dev)
#
# ────────────────────────────────────────────────────────

APP_NAME="Projet PFE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Database ────────────────────────────────────────────
# For local dev (SQLite, no server needed):
#   DB_CONNECTION=sqlite
#   DB_DATABASE=<project>/backend/database/database.sqlite
#
# For Docker (MySQL in container):
#   DB_CONNECTION=mysql
#   DB_HOST=db
#   DB_PORT=3306
#   DB_DATABASE=projet_pfe
#   DB_USERNAME=projet_user
#   DB_PASSWORD=projet_password
#
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache ────────────────────────────────────
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── Mail (Mailtrap) ────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@casaway.ma
MAIL_FROM_NAME=CasaWay

# ── Frontend ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ── Stripe ─────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Frontend env vars (used by Vite at build time) ─────
# For local dev with Vite proxy (recommended), leave blank.
# For local dev without proxy, set to http://localhost:8000
VITE_API_URL=
VITE_APP_NAME="${APP_NAME}"
