@startuml

!define ENTITY class
!define VALUE object

' ═══════════════════════════════════════════════
' PACKAGE: Backend (Laravel PHP)
' ═══════════════════════════════════════════════
package "Backend (Laravel)" {

  ' ─── Models ───
  package "Models" {
    ENTITY User <<Authenticatable>> {
      + uuid: string
      + email: string
      + phone: string
      + password_hash: string
      + pin_hash: string
      + full_name: string
      + avatar_path: string
      + is_active: boolean
      + is_student: boolean
      + last_active_at: datetime
      + default_ticket_id: int
      + notification_prefs: array
      + user_preferences: array
      + email_verified_at: datetime
      + recovery_email: string
      + fcm_token: string
      + wallet(): HasOne
      + transactions(): HasMany
      + tickets(): HasMany
      + defaultTicket(): BelongsTo
      + studentVerification(): HasOne
    }

    ENTITY Admin <<Authenticatable>> {
      + first_name: string
      + last_name: string
      + email: string
      + password: string
      + is_active: boolean
      + is_super_admin: boolean
      + must_change_password: boolean
      + getFullNameAttribute(): string
    }

    ENTITY Ticket <<Model>> {
      + uuid: string
      + user_id: int
      + ticket_type_id: int
      + purchase_id: string
      + status: string
      + valid_from: datetime
      + valid_until: datetime
      + remaining_uses: int
      + price_paid: decimal
      + ticketType(): BelongsTo
      + user(): BelongsTo
    }

    ENTITY TicketType <<Model>> {
      + code: string
      + name: string
      + description: string
      + price: decimal
      + student_price: decimal
      + duration_minutes: int
      + is_reusable: boolean
      + max_uses: int
      + is_active: boolean
    }

    ENTITY Wallet <<Model>> {
      + user_id: int
      + balance: decimal
      + user(): BelongsTo
    }

    ENTITY Transaction <<Model>> {
      + uuid: string
      + payment_intent_id: string
      + user_id: int
      + type: string
      + status: string
      + amount: decimal
      + currency: string
      + balance_before: decimal
      + balance_after: decimal
      + payment_method: string
      + reference: string
      + metadata: array
      + user(): BelongsTo
    }

    ENTITY Notification <<Model>> {
      + user_id: int
      + type: string
      + severity: string
      + title: string
      + body: string
      + meta: array
      + is_read: boolean
      + read_at: datetime
      + user(): BelongsTo
      + markRead(): void
    }

    ENTITY AuditLog <<Model>> {
      + user_id: int
      + action: string
      + ip_address: string
      + user_agent: string
      + metadata: array
      + user(): BelongsTo
      + log(action, userId, metadata): AuditLog
    }

    ENTITY StudentVerification <<Model>> {
      + user_id: int
      + cin_doc_path: string
      + school_doc_path: string
      + status: string
      + admin_id: int
      + rejected_reason: string
      + user(): BelongsTo
      + admin(): BelongsTo
    }

    ENTITY PendingRegistration <<Model>> {
      + email: string
      + phone: string
      + password_hash: string
      + full_name: string
      + email_verification_code: string
      + generateVerificationCode(): string
    }

    ENTITY ValidationLog <<Model>> {
      + ticket_id: int
      + user_id: int
      + validator_id: string
      + validation_type: string
      + status: string
      + failure_reason: string
      + location: array
      + metadata: array
    }

    ENTITY Repport <<Model>> {
      + user_id: int
      + type_probleme: string
      + sujet: string
      + description: string
      + image_path: string
      + statut: string
      + image_url: string
      + client(): BelongsTo
    }

    ' ─── Relationships ───
    User "1" --> "1" Wallet : has
    User "1" --> "*" Transaction : has
    User "1" --> "*" Ticket : has
    User "1" --> "0..1" StudentVerification : has
    User "1" --> "*" Notification : has
    User "1" --> "*" AuditLog : has
    User "1" --> "*" Repport : submits
    Ticket "*" --> "1" TicketType : belongs to
    Ticket "*" --> "1" User : belongs to
    Ticket "1" --> "0..1" ValidationLog : logged in
    StudentVerification "*" --> "1" Admin : reviewed by
  }

  ' ─── Services ───
  package "Services" {
    ENTITY TicketValidationService {
      + normalizeTicketStatus(ticket): void
      + isTicketExpired(ticket): boolean
      + shouldConsumeUse(ticket): boolean
      + canValidateStatus(status): boolean
      + resolveDefaultTicketForUser(user): Ticket
      + buildValidationToken(payload): string
      + parseValidationToken(token): array
      + validateTicketByUuid(uuid, user, type, validatorId): array
      + adminValidateTicketByUuid(uuid, validatorId): array
      + logValidation(ticketId, userId, validatorId, type, status): void
    }

    ENTITY NotificationService {
      + send(user, type, severity, title, body, meta): Notification
      - sendFcmPush(user, title, body, data): void
      + invalidateUnreadCache(userId): void
    }
  }

  ' ─── Jobs ───
  package "Jobs" {
    ENTITY ExpireTicketIfEligibleJob <<Queueable>>
    ENTITY ProcessStripeWebhookJob <<Queueable>>
    ENTITY SendAdminNotificationJob <<Queueable>>
  }

  ' ─── Notifications ───
  package "Notifications" {
    ENTITY PinResetNotification <<Notification>>
    ENTITY ResetPasswordNotification <<Notification>>
    ENTITY VerifyEmailNotification <<Notification>>
  }

  ' ─── Commands ───
  package "Console Commands" {
    ENTITY CleanupExpiredData <<Command>>
    ENTITY SendTicketExpiryReminders <<Command>>
  }
}

' ═══════════════════════════════════════════════
' PACKAGE: Frontend (React + Redux)
' ═══════════════════════════════════════════════
package "Frontend (React)" {

  ' ─── Redux Store ───
  package "Redux Store" {
    ENTITY "Redux Store" as Store {
      auth: AuthSlice
      wallet: WalletSlice
      tickets: TicketsSlice
      notifications: NotificationSlice
      admin: AdminSlice
      settings: SettingsSlice
      ui: UISlice
    }

    ENTITY AuthSlice <<Slice>> {
      user: object
      isAuthenticated: boolean
      status: string
      initialized: boolean
      error: object
      + login(credentials): AsyncThunk
      + getProfile(): AsyncThunk
      + logout(): AsyncThunk
    }

    ENTITY WalletSlice <<Slice>> {
      balance: number
      transactions: array
      status: string
      error: object
      + getWalletData(): AsyncThunk
      + updateBalance(amount): Reducer
    }

    ENTITY TicketsSlice <<Slice>> {
      items: array
      availableTypes: array
      status: string
      error: object
      + getTicketsData(): AsyncThunk
      + purchaseTicket(payload): AsyncThunk
      + validateTicket(uuid): AsyncThunk
    }

    ENTITY NotificationSlice <<Slice>> {
      items: array
      unreadCount: number
      activeFilter: string
      pagination: object
      loading: boolean
      + fetchNotifications(): AsyncThunk
      + fetchMoreNotifications(): AsyncThunk
      + markRead(id): AsyncThunk
      + markAllRead(): AsyncThunk
      + removeNotification(id): AsyncThunk
    }

    ENTITY AdminSlice <<Slice>> {
      admin: object
      token: string
      isAuthenticated: boolean
      adminChecked: boolean
      mustChangePassword: boolean
      + loginAdmin(credentials): AsyncThunk
      + fetchAdminMe(): AsyncThunk
      + logoutAdmin(): AsyncThunk
      + updateAdmin(data): AsyncThunk
    }

    ENTITY SettingsSlice <<Slice>> {
      theme: string
      language: string
      + setTheme(theme): Reducer
      + setLanguage(lang): Reducer
      + toggleTheme(): Reducer
    }

    ENTITY UISlice <<Slice>> {
      isGlobalLoading: boolean
      isRouteLoading: boolean
      + setGlobalLoading(bool): Reducer
      + setRouteLoading(bool): Reducer
    }
  }

  ' ─── Services ───
  package "Services" {
    ENTITY userService <<Service>>
    ENTITY ticketService <<Service>>
    ENTITY ticketsService <<Service>>
    ENTITY walletService <<Service>>
    ENTITY notificationService <<Service>>
    ENTITY adminService <<Service>>
    ENTITY pinService <<Service>>
    ENTITY rapportService <<Service>>
    ENTITY homeService <<Service>>
  }

  ' ─── Custom Hooks ───
  package "Hooks" {
    ENTITY useAuth <<Hook>>
    ENTITY useWallet <<Hook>>
    ENTITY useTickets <<Hook>>
    ENTITY usePolling <<Hook>>
    ENTITY usePinGuard <<Hook>>
    ENTITY useTranslation <<Hook>>
  }

  ' ─── Layout Components ───
  package "Layout" {
    ENTITY ProtectedRoute <<Component>>
    ENTITY PublicRoute <<Component>>
    ENTITY AuthLayout <<Component>>
    ENTITY AdminLayout <<Component>>
    ENTITY Header <<Component>>
    ENTITY BottomNavigation <<Component>>
    ENTITY ModalOverlay <<Component>>
    ENTITY SectionHeader <<Component>>
    ENTITY TransactionGroup <<Component>>
  }

  ' ─── Card Components ───
  package "Cards" {
    ENTITY TicketCard <<Component>>
    ENTITY TicketHistoryCard <<Component>>
    ENTITY TicketInfoCard <<Component>>
    ENTITY BalanceCard <<Component>>
    ENTITY DefaultTicketCard <<Component>>
    ENTITY TransactionItem <<Component>>
    ENTITY TransactionDetailsCard <<Component>>
    ENTITY ValidationCard <<Component>>
    ENTITY PaymentOptionCard <<Component>>
    ENTITY InfoCard <<Component>>
    ENTITY ActionButtonCard <<Component>>
    ENTITY AmountDisplay <<Component>>
    ENTITY JourneyInfoCard <<Component>>
  }

  ' ─── UI Components ───
  package "UI" {
    ENTITY QRCodeDisplay <<Component>>
    ENTITY PINGuardModal <<Component>>
    ENTITY NotificationButton <<Component>>
    ENTITY Notification_ <<Component>>
    ENTITY SphereLoader <<Component>>
    ENTITY GlobalPageLoader <<Component>>
    ENTITY LoadingOverlay <<Component>>
    ENTITY ProfileAvatar <<Component>>
    ENTITY ProfileImageUpload <<Component>>
    ENTITY ProfileMenuCard <<Component>>
    ENTITY LanguageSwitcher <<Component>>
    ENTITY TimerDisplay <<Component>>
    ENTITY NFCAnimation <<Component>>
    ENTITY StatusIndicator <<Component>>
    ENTITY FilterTabs <<Component>>
    ENTITY SettingsToggle <<Component>>
    ENTITY SettingsMenuItem <<Component>>
    ENTITY ContactCard <<Component>>
    ENTITY GoldenSpinner <<Component>>
    ENTITY ProcessingIndicator <<Component>>
  }

  ' ─── Page Components ───
  package "Pages" {

    package "Auth" {
      ENTITY LoginPage <<Page>>
      ENTITY SignUpPage <<Page>>
      ENTITY VerifyEmailPage <<Page>>
      ENTITY ForgotPasswordPage <<Page>>
      ENTITY ResetPasswordPage <<Page>>
    }

    package "Home" {
      ENTITY HomePage <<Page>>
    }

    package "Profile" {
      ENTITY ProfilePage <<Page>>
      ENTITY EditProfilePage <<Page>>
      ENTITY SettingsPage <<Page>>
      ENTITY SecurityPage <<Page>>
      ENTITY HelpSupportPage <<Page>>
      ENTITY StudentVerificationPage <<Page>>
    }

    package "Tickets" {
      ENTITY MyTicketsPage <<Page>>
      ENTITY TicketsHistoryPage <<Page>>
      ENTITY TicketSelectionPage <<Page>>
      ENTITY TicketDetailPage <<Page>>
    }

    package "Validation" {
      ENTITY ValidationPage <<Page>>
      ENTITY ValidationSuccessPage <<Page>>
    }

    package "Payment" {
      ENTITY WalletPage <<Page>>
      ENTITY PaymentPage <<Page>>
      ENTITY RechargePaymentPage <<Page>>
      ENTITY PaymentConfirmationPage <<Page>>
      ENTITY PaymentHistoryPage <<Page>>
      ENTITY ChangeDefaultCardPage <<Page>>
    }

    package "Notifications" {
      ENTITY NotificationsPage <<Page>>
    }

    package "Admin" {
      ENTITY AdminDashboard <<Page>>
      ENTITY AdminUsers <<Page>>
      ENTITY AdminTickets <<Page>>
      ENTITY AdminTransactions <<Page>>
      ENTITY AdminTicketTypes <<Page>>
      ENTITY AdminNotifications <<Page>>
      ENTITY AdminRapports <<Page>>
      ENTITY AdminStudentVerifications <<Page>>
      ENTITY AdminAuditLogs <<Page>>
      ENTITY AdminAdmins <<Page>>
      ENTITY AdminProfile <<Page>>
      ENTITY AdminSettings <<Page>>
      ENTITY AdminLogin <<Page>>
      ENTITY AdminForcePasswordChange <<Page>>
      ENTITY ValidatorPage <<Page>>
    }
  }
}

' ─── Cross-boundary relationships ───
Store --> AuthSlice
Store --> WalletSlice
Store --> TicketsSlice
Store --> NotificationSlice
Store --> AdminSlice
Store --> SettingsSlice
Store --> UISlice

note "Backend: Laravel (PHP)\nFrontend: React + Redux\nDatabase: MySQL" as n1
n1 -[#e94560]-> Backend
n1 -[#e94560]-> Frontend

@enduml
